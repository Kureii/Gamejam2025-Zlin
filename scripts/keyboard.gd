extends Node3D

signal click(id: int)

@export var id_a: int
@export var id_c: int
@export var id_d: int
@export var id_e: int
@export var id_f: int
@export var id_g: int
@export var id_h: int



func _on_d_area_3d_input_event(camera: Node, event: InputEvent, event_position: Vector3, normal: Vector3, shape_idx: int) -> void:
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		emit_signal("click", id_d)

